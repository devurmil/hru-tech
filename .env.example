# ---------------------------------------------------------------
# HRU Technologies — contact form SMTP
# Copy this file to .env and fill in your real credentials.
#   cp .env.example .env
# ---------------------------------------------------------------

# --- SMTP server (works with any provider) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@hrutechnologies.com
SMTP_PASS=your-mailbox-password-here

# Leave blank to auto-detect (true for port 465, false for 587).
SMTP_SECURE=

# --- Addresses ---
# The From header. Most providers require this to match SMTP_USER.
MAIL_FROM="HRU Technologies Website" <hello@hrutechnologies.com>
# Where enquiries land. Defaults to SMTP_USER if unset.
MAIL_TO=hello@hrutechnologies.com

# Send a confirmation email back to the sender. Set to false to disable.
SEND_AUTOREPLY=true

# --- Server ---
PORT=8787
# Restrict the API to your domain in production, e.g. https://hrutechnologies.com
CORS_ORIGIN=

# --- Shown in the auto-reply email ---
COMPANY_NAME=HRU Technologies
COMPANY_PHONE=+91 00000 00000

# ---------------------------------------------------------------
# Common provider settings
# ---------------------------------------------------------------
# Hostinger        smtp.hostinger.com      465  (SSL)
# Zoho Mail        smtp.zoho.com           465  (SSL)
# Zoho (EU/IN)     smtp.zoho.eu / .in      465  (SSL)
# Google Workspace smtp.gmail.com          587  (requires an App Password)
# Microsoft 365    smtp.office365.com      587
# SendGrid         smtp.sendgrid.net       587  (user: "apikey")
# Amazon SES       email-smtp.<region>.amazonaws.com  587
# GoDaddy          smtpout.secureserver.net 465
